# Valores teóricos para una ruleta europea
media_teorica = sum(range(37)) / 37            # 18.0
varianza_teorica = sum((x - media_teorica)**2 for x in range(37)) / 37  # 114.0
desvio_teorico = np.sqrt(varianza_teorica)   # 10.68 
frecuencia_teorica = 1 / 37                    # 0.027 - Probabilidad de acierto

def simular_ruleta_avanzado(cant_tiradas, numero_elegido):
    resultados = []
    fr_acum = []
    prom_acum = []
    var_acum = []
    std_acum = []
    aciertos = 0

    for i in range(1, cant_tiradas + 1):
        numero = np.random.randint(0, 37)
        resultados.append(numero)
        if numero == numero_elegido:
            aciertos += 1

        fr_acum.append(aciertos / i)
        prom_acum.append(np.mean(resultados))
        var_acum.append(np.var(resultados))
        std_acum.append(np.std(resultados))

    return fr_acum, prom_acum, var_acum, std_acum, resultados

def graficar_multiple(x, todas_y, y_teorica, titulo, ylabel, nombre_archivo):
    plt.figure(figsize=(8, 5))
    for idx, y in enumerate(todas_y, start=1):
        plt.plot(x, y, label=f'Corrida {idx}')
    plt.axhline(y=y_teorica, color='black', linestyle='--', label='Teórico')
    plt.xlabel('n (número de tiradas)')
    plt.ylabel(ylabel)
    plt.title(titulo)
    plt.legend()
    plt.grid(True)
    plt.savefig(nombre_archivo)
    plt.close()

def graficar_histograma(todas_corridas, cant_tiradas, nombre_archivo):
    bins = np.arange(-0.5, 37.5, 1)  
    fig, ax = plt.subplots(figsize=(8, 5))
    for idx, resultados in enumerate(todas_corridas, start=1):
        ax.hist(resultados, bins=bins, alpha=0.5, rwidth=0.8, label=f'Corrida {idx}')
    frecuencia_absoluta_teorica = cant_tiradas / 37 # número de veces que se espera que salga cada número
    ax.axhline(y=frecuencia_absoluta_teorica, color='black', linestyle='--', label='Teórico')
    ax.set_xlabel('Números')
    ax.set_ylabel('Cantidad de Apariciones')
    ax.set_title(f'Histograma Ruleta con {cant_tiradas} tiradas')
    ax.set_xlim([-0.5, 36.5])
    ax.legend()
    plt.savefig(nombre_archivo)
    plt.close(fig)

def main():
    parser = argparse.ArgumentParser(description='Simulación de una ruleta.')
    parser.add_argument('-c', type=int, default=10, help='Cantidad de corridas')
    parser.add_argument('-n', type=int, default=300, help='Cantidad de tiradas por corrida')
    parser.add_argument('-e', type=int, default=17, help='Número elegido')
    args = parser.parse_args()

    # Para almacenar los resultados de cada corrida
    todas_fr = []
    todos_prom = []
    todas_var = []
    todos_std = []
    todos_res = []
    x = list(range(1, args.n + 1))

    # Ejecutar corridas y recopilar datos
    for corrida in range(1, args.c + 1):
        fr, prom, var, std, res = simular_ruleta_avanzado(args.n, args.e)
        todas_fr.append(fr)
        todos_prom.append(prom)
        todas_var.append(var)
        todos_std.append(std)
        todos_res.append(res)

    # Graficar todo junto
    graficar_multiple(
        x, todas_fr, frecuencia_teorica,
        'Frecuencia relativa acumulada del número ' + str(args.e),
        'fr (frecuencia relativa)',
        'Frecuencia relativa.png'
    )
    graficar_multiple(
        x, todos_prom, media_teorica,
        'Promedio acumulado de las tiradas',
        'vp (valor promedio)',
        'Promedio.png'
    )
    graficar_multiple(
        x, todos_std, desvio_teorico,
        'Desvío estándar acumulado de las tiradas',
        'vd (desvío estándar)',
        'Desvio.png'
    )
    graficar_multiple(
        x, todas_var, varianza_teorica,
        'Varianza acumulada de las tiradas',
        'vv (varianza)',
        'Varianza.png'
    )

    graficar_histograma(
        todos_res, args.n, 'Histograma.png'
    )

    fr_final = [fr_run[-1] for fr_run in todas_fr]
    prom_final = [p_run[-1] for p_run in todos_prom]
    var_final = [v_run[-1] for v_run in todas_var]
    std_final = [s_run[-1] for s_run in todos_std]

    print("Gráficos comparativos generados y guardados.")
    print("Cantidad de corridas: "+str(args.c))
    print("Cantidad de tiradas: "+str(args.n))
    print("Numero elegido: "+ str(args.e))
    print("=== Promedio entre todas las corridas ===")
    print(f"Frecuencia relativa media: {np.mean(fr_final):.4f}") #f trunca decimales
    print(f"Promedio medio: {np.mean(prom_final):.4f}") #.4f = 4 decimales
    print(f"Varianza media: {np.mean(var_final):.4f}")
    print(f"Desvío estándar medio: {np.mean(std_final):.4f}")

if __name__ == "__main__":
    main()
